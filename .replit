modules = ["nodejs-24", "python-base-3.13"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Portfolio site"

[[workflows.workflow]]
name = "Portfolio site"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/sai-tarun-portfolio run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
